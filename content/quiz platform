        questions: [
          {
            id: crypto.randomUUID(),
            prompt: "What directly triggers skeletal muscle contraction?",
            choices: ["ATP binding to myosin", "Ca²⁺ binding to troponin", "Na⁺ leaving the cell", "O₂ binding to hemoglobin"],
